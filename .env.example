# Local Python/uvicorn directory for downloaded Parquet files, the index and logs.
# Docker Compose ignores these paths and always uses its persistent /data volume.
REFERENCE_DATA_DIR=./data

# Optional source directory. For local development set this to ./.source and
# place one or more IR_data_chunkXXX_of_009.parquet files there.
# https://zenodo.org/records/16417648
# Docker Compose overrides this to /data/source inside the persistent volume;
# leave it unchanged when deploying with Docker.
REFERENCE_SOURCE_DIR=./.source

# Comma-separated browser origins permitted to call this API directly. For a
# local file:// page use null; for production use the exact static site origin.
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,null
# Optional: allow localhost/127.0.0.1 on any port without opening CORS to all sites.
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# Required in a public deployment. Generate long random values and do not commit .env.
ADMIN_TOKEN=replace-with-a-long-random-admin-token
SERVICE_TOKEN=replace-with-a-different-long-random-service-token

# Zenodo source, fixed to a versioned record for reproducible results.
ZENODO_RECORD_ID=16417648
REFERENCE_VECTOR_POINTS=512
PUBCHEM_TIMEOUT_SECONDS=12
LOG_LEVEL=INFO
